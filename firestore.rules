rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // User records and roles are provisioned by trusted backend code.
      allow write: if isAdmin();
    }

    match /attendanceEvents/{eventId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      // Devices and clients must submit events through a trusted backend.
      allow create, update, delete: if false;
    }

    match /devices/{deviceId} {
      allow read, write: if isAdmin();
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
